{
  "name": "grip-empire",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sim": "tsx sim/simulate.ts",
    "typecheck": "tsc --noEmit",
    "sim:all": "tsx sim/simulate.ts active 6 && tsx sim/simulate.ts mixed 6 && tsx sim/simulate.ts idle 6",
    "saves": "tsx scripts/make-save.ts",
    "check:browser": "tsx scripts/browser-check.ts"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
